<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/llInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_core_text_field"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/xs">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivStart"
            android:layout_width="@dimen/dimen_24"
            android:layout_height="@dimen/dimen_24"
            android:layout_marginEnd="@dimen/xxs"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:labelFor="@id/etInput"
                android:maxLines="1"
                android:minHeight="@dimen/dimen_14"
                android:textColor="?attr/coreTextFieldSupportingColor"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:ellipsize="end"
                android:gravity="center_vertical|start"
                android:includeFontPadding="false"
                android:padding="@dimen/dimen_0"
                android:saveEnabled="false"
                android:singleLine="true"
                android:textCursorDrawable="@drawable/bg_core_input_cursor"
                android:textColor="@color/slr_core_text_field_text"
                android:textColorHint="?attr/coreTextFieldPlaceholder" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnEnd"
            android:layout_width="@dimen/dimen_24"
            android:layout_height="@dimen/dimen_24"
            android:layout_marginStart="@dimen/xxs"
            android:background="@null"
            android:padding="@dimen/dimen_0"
            android:scaleType="centerInside"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/llSupporting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/xxxs"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvSupporting"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/slr_core_text_field_supporting" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/xxs"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/slr_core_text_field_supporting"
            android:visibility="gone" />

    </LinearLayout>

</merge>
