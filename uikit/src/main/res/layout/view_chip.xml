<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:theme="@style/Theme.EDTS.UIKit"
    app:cardCornerRadius="@dimen/dimen_90"
    app:cardBackgroundColor="@color/foundation_color_grey_20"
    app:strokeWidth="@dimen/dimen_0"
    app:contentPaddingLeft="@dimen/xxs"
    app:contentPaddingRight="@dimen/xxs"
    app:contentPaddingTop="@dimen/xxxs"
    app:contentPaddingBottom="@dimen/xxxs" >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivStartIcon"
            android:layout_width="@dimen/s"
            android:layout_height="@dimen/s"
            android:layout_marginEnd="@dimen/xxxs"
            android:src="@drawable/ic_placeholder_medium_24"
            app:tint="@color/foundation_color_primary_blue_30"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.EDTS.UIKit.CircularComponent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvTitle"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="?b3SemiBold"
            android:textColor="@color/foundation_color_primary_blue_30"
            tools:text="Chip"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivStartIcon"
            app:layout_constraintEnd_toStartOf="@id/ivEndIcon" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivEndIcon"
            android:layout_width="@dimen/s"
            android:layout_height="@dimen/s"
            android:layout_marginStart="@dimen/xxxs"
            android:src="@drawable/ic_placeholder_medium_24"
            app:tint="@color/foundation_color_primary_blue_30"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.EDTS.UIKit.CircularComponent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>