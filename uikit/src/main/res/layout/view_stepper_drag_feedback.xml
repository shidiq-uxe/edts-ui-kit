<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/xs"
    android:paddingVertical="@dimen/xxs"
    android:background="@drawable/bg_stepper_drag_feedback"
    android:gravity="center"
    android:orientation="horizontal"
    android:importantForAccessibility="noHideDescendants">

    <TextView
        android:id="@+id/tvDirection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Inter.SemiBold.B3"
        android:textColor="@color/primary_50"
        android:gravity="center"
        android:maxLines="1" />

    <FrameLayout
        android:id="@+id/chevronIndicator"
        android:layout_width="@dimen/m2"
        android:layout_height="@dimen/m2"
        android:layout_marginStart="@dimen/xxs"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:id="@+id/ivChevronFirst"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_chevron_up_16"
            android:contentDescription="@null"
            app:tint="@color/primary_50" />

        <ImageView
            android:id="@+id/ivChevronSecond"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_chevron_up_16"
            android:contentDescription="@null"
            android:visibility="invisible"
            app:tint="@color/primary_50" />

        <ImageView
            android:id="@+id/ivChevronThird"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_chevron_up_16"
            android:contentDescription="@null"
            android:visibility="invisible"
            app:tint="@color/primary_50" />

    </FrameLayout>

</LinearLayout>
