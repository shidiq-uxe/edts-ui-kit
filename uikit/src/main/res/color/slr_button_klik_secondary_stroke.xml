<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:state_enabled="false"
        android:color="@color/klik_color_stroke_disabled_intense" />
    <item
        app:state_destructive="true"
        android:state_enabled="true"
        android:state_pressed="true"
        android:color="@color/klik_color_stroke_attention_or_error_intense" />
    <item
        app:state_destructive="true"
        android:color="@color/klik_color_stroke_interactive_attention_or_error" />
    <item
        android:state_enabled="true"
        android:state_pressed="true"
        android:color="@color/klik_color_stroke_interactive_pressed" />
    <item
        android:color="@color/klik_color_stroke_interactive_default" />
</selector>
