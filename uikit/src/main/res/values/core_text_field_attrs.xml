<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="coreTextFieldStyle" format="reference" />
    <attr name="coreTextFieldSurface" format="color" />
    <attr name="coreTextFieldDisabledSurface" format="color" />
    <attr name="coreTextFieldErrorSurface" format="color" />
    <attr name="coreTextFieldStroke" format="color" />
    <attr name="coreTextFieldFocusedStroke" format="color" />
    <attr name="coreTextFieldErrorColor" format="color" />
    <attr name="coreTextFieldText" format="color" />
    <attr name="coreTextFieldPlaceholder" format="color" />
    <attr name="coreTextFieldSupportingColor" format="color" />
    <attr name="coreTextFieldRequiredColor" format="color" />
    <attr name="coreInputCursorColor" format="color" />

    <declare-styleable name="CoreTextField">
        <attr name="android:enabled" />
        <attr name="android:text" />
        <attr name="android:hint" />
        <attr name="android:inputType" />
        <attr name="android:imeOptions" />
