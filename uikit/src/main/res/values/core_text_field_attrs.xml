        <attr name="fieldEndIcon" format="reference" />
        <attr name="fieldPasswordToggleEnabled" format="boolean" />
        <attr name="coreTextFieldLabelAppearance" format="reference" />
        <attr name="coreTextFieldInputAppearance" format="reference" />
        <attr name="coreTextFieldSupportingAppearance" format="reference" />
        <attr name="coreTextFieldInputLineHeight" format="dimension" />
        <attr name="coreTextFieldSupportingLineHeight" format="dimension" />
