<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content">

    <TextView android:id="@+id/summary" style="@style/FairDemo.Body" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView android:id="@+id/scroll" android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintTop_toBottomOf="@id/summary" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="24dp">

            <LinearLayout android:id="@+id/productsSection" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="8dp">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/products" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <LinearLayout android:id="@+id/giftSection" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="16dp">
                <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <id.co.edtslib.uikit.core.textbadge.CoreTextBadge android:id="@+id/fairBadge" android:layout_width="wrap_content"
                        android:layout_height="24dp" app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                    <LinearLayout android:id="@+id/edit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="4dp" android:paddingStart="8dp"
                        android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
                        <TextView android:id="@+id/editLabel" style="@style/FairDemo.Strong" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="Ubah" android:textColor="@color/primary_30"
                            android:layout_marginEnd="4dp" android:importantForAccessibility="no" />
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/fair_chevron"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.recyclerview.widget.RecyclerView android:id="@+id/gifts" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>