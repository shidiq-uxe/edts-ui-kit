<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    tools:context=".GuidelinesSegmentSwitcherActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:padding="@dimen/s">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fixed — 2 Tabs"
                android:textAppearance="@style/TextAppearance.Inter.Semibold.H2"
                android:layout_marginBottom="@dimen/xxs" />

            <id.co.edtslib.uikit.switcher.SegmentSwitcher
                android:id="@+id/switcher2Tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fixed — 3 Tabs"
                android:textAppearance="@style/TextAppearance.Inter.Semibold.H2"
                android:layout_marginTop="@dimen/m2"
                android:layout_marginBottom="@dimen/xxs" />

            <id.co.edtslib.uikit.switcher.SegmentSwitcher
                android:id="@+id/switcher3Tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scrollable — 6 Tabs"
                android:textAppearance="@style/TextAppearance.Inter.Semibold.H2"
                android:layout_marginTop="@dimen/m2"
                android:layout_marginBottom="@dimen/xxs" />

            <id.co.edtslib.uikit.switcher.SegmentSwitcher
                android:id="@+id/switcherScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fixed — 2 Tabs (Custom Layout)"
                android:textAppearance="@style/TextAppearance.Inter.Semibold.H2"
                android:layout_marginTop="@dimen/m2"
                android:layout_marginBottom="@dimen/xxs" />

            <id.co.edtslib.uikit.switcher.SegmentSwitcher
                android:id="@+id/switcherCustomFixed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scrollable — 4 Tabs (Custom Layout + Wrap)"
                android:textAppearance="@style/TextAppearance.Inter.Semibold.H2"
                android:layout_marginTop="@dimen/m2"
                android:layout_marginBottom="@dimen/xxs" />

            <id.co.edtslib.uikit.switcher.SegmentSwitcher
                android:id="@+id/switcherCustomScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
