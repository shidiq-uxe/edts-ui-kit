<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <id.co.edtslib.uikit.switcher.HomeSwitcher
        android:id="@+id/switcher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:firstTabTitle="Chip"
        app:firstTabSubtitle="Appearance"
        app:firstTabIcon="@drawable/ic_placeholder_medium_24"
        app:secondTabTitle="Chip Group"
        app:secondTabSubtitle="Layout"
        app:secondTabIcon="@drawable/ic_placeholder_medium_24" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/paneChip"
            layout="@layout/bottom_sheet_chip_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/paneChipGroup"
            layout="@layout/bottom_sheet_chip_group_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>