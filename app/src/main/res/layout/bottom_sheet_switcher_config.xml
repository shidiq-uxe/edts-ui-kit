<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preset Themes"
        android:textAppearance="@style/TextAppearance.Inter.Semibold.H2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeDefault"
            style="@style/Widget.EDTS.UIKit.Button.Outlined.Secondary.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeOrange"
            style="@style/Widget.EDTS.UIKit.Button.Outlined.Secondary.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Orange" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeGreen"
            style="@style/Widget.EDTS.UIKit.Button.Outlined.Secondary.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Green" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        app:dividerColor="@color/black_30" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Options"
        android:textAppearance="@style/TextAppearance.Inter.Semibold.H2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Animation"
            android:textAppearance="@style/TextAppearance.Inter.Regular.B2" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swAnimate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Draggable"
            android:textAppearance="@style/TextAppearance.Inter.Regular.B2" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swDraggable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wrap Tab Width"
            android:textAppearance="@style/TextAppearance.Inter.Regular.B2" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swWrapWidth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Corner Radius"
            android:textAppearance="@style/TextAppearance.Inter.Regular.B2" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slCornerRadius"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:valueFrom="0"
            android:valueTo="64"
            android:value="12"
            android:stepSize="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCornerRadiusValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="12dp"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.Inter.Regular.B4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Width Factor"
            android:textAppearance="@style/TextAppearance.Inter.Regular.B2" />

        <com.google.android.material.slider.Slider
            android:id="@+id/slWidthFactor"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:valueFrom="0.15"
            android:valueTo="0.40"
            android:value="0.23"
            android:stepSize="0.01" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvWidthFactorValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0.23"
        android:gravity="end"
        android:textAppearance="@style/TextAppearance.Inter.Regular.B4" />

</LinearLayout>
