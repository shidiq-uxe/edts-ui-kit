<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".GuidelinesListItemActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvProductsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/s"
            android:layout_marginTop="@dimen/s"
            android:text="Product Grid"
            android:textAppearance="@style/TextAppearance.Inter.Bold.B2"
            android:textSize="20sp"
            android:textColor="@color/black_70"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tvProductsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/s"
            android:layout_marginTop="@dimen/xxxs"
            android:text="Demo of click and long click on product grid"
            android:textAppearance="@style/TextAppearance.Inter.Regular.B2"
            android:textColor="@color/black_40"
            app:layout_constraintTop_toBottomOf="@id/tvProductsTitle"/>

        <View
            android:id="@+id/dividerProductsHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_1"
            android:layout_marginTop="@dimen/s"
            android:background="@color/black_30"
            app:layout_constraintTop_toBottomOf="@id/tvProductsSubtitle"/>

        <!-- Product grid: item_grid_product cards, driven by ProductAdapter -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/xs"
            android:paddingVertical="@dimen/s"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/dividerProductsHeader"/>

        <!-- Thick band that separates the two sections -->
        <View
            android:id="@+id/sectionGap"
            android:layout_width="match_parent"
            android:layout_height="@dimen/xs"
            android:alpha="0.4"
            android:background="@color/black_30"
            app:layout_constraintTop_toBottomOf="@id/rvProducts"/>

        <TextView
            android:id="@+id/tvCartTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/s"
            android:layout_marginTop="@dimen/s"
            android:text="Cart List"
            android:textAppearance="@style/TextAppearance.Inter.Bold.B2"
            android:textSize="20sp"
            android:textColor="@color/black_70"
            app:layout_constraintTop_toBottomOf="@id/sectionGap"/>

        <TextView
            android:id="@+id/tvCartSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/s"
            android:layout_marginTop="@dimen/xxxs"
            android:text="Demo of gestures on cart list with logic"
            android:textAppearance="@style/TextAppearance.Inter.Regular.B2"
            android:textColor="@color/black_40"
            app:layout_constraintTop_toBottomOf="@id/tvCartTitle"/>

        <View
            android:id="@+id/dividerCartHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dimen_1"
            android:layout_marginTop="@dimen/s"
            android:background="@color/black_30"
            app:layout_constraintTop_toBottomOf="@id/tvCartSubtitle"/>

        <!-- Cart section: select all / delete, item_cart_product rows (same data as the grid), subtotal -->
        <include
            android:id="@+id/cartSection"
            layout="@layout/item_cart_product_content_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/dividerCartHeader"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>