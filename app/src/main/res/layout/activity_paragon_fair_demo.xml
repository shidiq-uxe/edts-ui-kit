<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@color/white"
    tools:context=".demo.promo.ParagonFairDemoActivity">
    <id.co.edtslib.uikit.pulltorefresh.LiteRefreshLayout
        android:id="@+id/refreshLayout"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <id.co.edtslib.uikit.header.CircleRefreshHeader
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/products"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="@dimen/dimen_72"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls" />

            <include
                android:id="@+id/skeleton"
                layout="@layout/view_fair_skeleton"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

    </id.co.edtslib.uikit.pulltorefresh.LiteRefreshLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/toolbar"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/xxl"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageButton
            android:id="@+id/back"
            style="@style/FairDemo.Icon"
            android:layout_width="@dimen/l"
            android:layout_height="@dimen/l"
            android:layout_marginStart="@dimen/xs"
            android:padding="@dimen/fair_back_icon_padding"
            android:src="@drawable/ic_arrow_left"
            android:contentDescription="@string/fair_back"
            app:tint="@color/black_50"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/title"
            style="@style/TextAppearance.Inter.Semibold.H1"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/xxs"
            android:textSize="@dimen/h1_text_size"
            android:text="@string/fair_title"
            android:maxLines="1"
            android:ellipsize="end"
            android:longClickable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/back"
            app:layout_constraintEnd_toStartOf="@id/search"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/search"
            style="@style/FairDemo.Icon"
            android:layout_width="@dimen/l"
            android:layout_height="@dimen/l"
            android:layout_marginEnd="@dimen/xxs"
            android:padding="@dimen/fair_search_icon_padding"
            android:clickable="false"
            android:focusable="false"
            android:background="@null"
            android:src="@drawable/fair_search"
            android:contentDescription="@string/fair_search"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/share"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/share"
            style="@style/FairDemo.Icon"
            android:layout_width="@dimen/l"
            android:layout_height="@dimen/l"
            android:layout_marginEnd="@dimen/xs"
            android:padding="@dimen/dimen_6"
            android:clickable="false"
            android:focusable="false"
            android:background="@null"
            android:src="@drawable/fair_share"
            android:contentDescription="@string/fair_share"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <id.co.edtslib.uikit.searchbar.SearchBar
            android:id="@+id/queryField"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="@dimen/l"
            android:layout_marginStart="@dimen/xs"
            android:layout_marginEnd="@dimen/s"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/compactProgress"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/s"
        android:paddingEnd="@dimen/s"
        android:paddingTop="@dimen/xs"
        android:paddingBottom="@dimen/xxs"
        android:background="@color/white"
        android:elevation="@dimen/dimen_2"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clipToOutline="false"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <include
            android:id="@+id/compactMeter"
            layout="@layout/view_fair_progress"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomActions"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/s"
        android:paddingBottom="@dimen/xxs"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clipToOutline="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/filterSortPill"
            android:layout_width="@dimen/fair_filter_pill_width"
            android:layout_height="@dimen/xl"
            android:background="@drawable/fair_filter_background"
            android:elevation="@dimen/dimen_3"
            android:clipToPadding="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/sort"
                android:layout_width="@dimen/fair_sort_action_width"
                android:layout_height="@dimen/m2"
                android:layout_marginStart="@dimen/xs"
                android:clickable="false"
                android:focusable="false"
                android:contentDescription="@string/fair_sort_description"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:layout_width="@dimen/m2"
                    android:layout_height="@dimen/m2"
                    android:padding="@dimen/xxxs"
                    android:src="@drawable/fair_sort"
                    android:importantForAccessibility="no"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/sortLabel"
                    style="@style/FairDemo.CaptionStrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fair_sort"
                    android:importantForAccessibility="no"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="@dimen/dimen_1"
                android:layout_height="@dimen/s"
                android:layout_marginStart="@dimen/xxs"
                android:background="@color/black_30"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/sort"
                app:layout_constraintBottom_toBottomOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/filter"
                android:layout_width="@dimen/fair_action_width"
                android:layout_height="@dimen/m2"
                android:layout_marginEnd="@dimen/xs"
                android:clickable="false"
                android:focusable="false"
                android:contentDescription="@string/fair_filter_description"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
                <ImageView
                    android:id="@+id/icFilter"
                    android:layout_width="@dimen/m2"
                    android:layout_height="@dimen/m2"
                    android:padding="@dimen/xxxs"
                    android:src="@drawable/fair_filter"
                    android:importantForAccessibility="no"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/filterLabel"
                    style="@style/FairDemo.CaptionStrong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/xxs"
                    android:text="@string/fair_filter"
                    android:importantForAccessibility="no"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/icFilter"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cart"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xs"
            android:paddingHorizontal="@dimen/xs"
            android:paddingVertical="@dimen/xxs"
            android:background="@drawable/fair_cart_background"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone"
            app:layout_goneMarginTop="@dimen/dimen_0"
            app:layout_constraintTop_toBottomOf="@id/filterSortPill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/cartIcon"
                android:layout_width="@dimen/m2"
                android:layout_height="@dimen/m2"
                android:padding="@dimen/dimen_3"
                android:src="@drawable/fair_cart"
                android:importantForAccessibility="no"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/cartLabel"
                style="@style/TextAppearance.Inter.Semibold.H3"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/xxs"
                android:text="@string/fair_cart_title"
                android:textColor="@color/black_70"
                android:importantForAccessibility="no"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/cartCount"
                app:layout_constraintStart_toEndOf="@id/cartIcon"
                app:layout_constraintEnd_toStartOf="@id/cartTotal"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/cartCount"
                style="@style/TextAppearance.Inter.Regular.B4"
                android:layout_width="@dimen/dimen_0"
                android:layout_height="wrap_content"
                android:textColor="@color/black_70"
                android:importantForAccessibility="no"
                app:layout_constraintTop_toBottomOf="@id/cartLabel"
                app:layout_constraintStart_toStartOf="@id/cartLabel"
                app:layout_constraintEnd_toEndOf="@id/cartLabel"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/cartTotal"
                style="@style/TextAppearance.Inter.Semibold.H3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black_70"
                android:importantForAccessibility="no"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
