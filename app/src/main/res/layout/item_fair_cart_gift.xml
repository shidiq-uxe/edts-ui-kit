<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/xs">
    <ImageView
        android:id="@+id/image"
        android:layout_width="@dimen/xxl"
        android:layout_height="@dimen/dimen_64"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <id.co.edtslib.uikit.recipes.textbadge.klik.KlikTextBadge
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/m2"
        android:layout_marginStart="@dimen/xs"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/image" />

    <TextView
        android:id="@+id/name"
        style="@style/FairDemo.Strong"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/xxs"
        android:layout_marginStart="@dimen/xs"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/badge"
        app:layout_constraintStart_toEndOf="@id/image"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/pack"
        style="@style/FairDemo.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/xxxs"
        android:textColor="@color/black_40"
        app:layout_constraintTop_toBottomOf="@id/name"
        app:layout_constraintStart_toStartOf="@id/name" />

    <TextView
        android:id="@+id/discount"
        style="@style/FairSearch.SmallStrong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/xxs"
        android:paddingHorizontal="@dimen/dimen_6"
        android:paddingVertical="@dimen/dimen_2"
        android:textColor="@color/klik_color_red_30"
        android:background="@drawable/fair_discount_background"
        app:layout_constraintTop_toBottomOf="@id/pack"
        app:layout_constraintStart_toStartOf="@id/name" />

    <TextView
        android:id="@+id/originalPrice"
        style="@style/FairDemo.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_6"
        android:textColor="@color/black_40"
        app:layout_constraintStart_toEndOf="@id/discount"
        app:layout_constraintBaseline_toBaselineOf="@id/discount" />

    <TextView
        android:id="@+id/price"
        style="@style/FairDemo.Strong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_6"
        android:textColor="@color/klik_color_red_30"
        app:layout_constraintStart_toEndOf="@id/originalPrice"
        app:layout_constraintBaseline_toBaselineOf="@id/discount" />

    <TextView
        android:id="@+id/qty"
        style="@style/FairDemo.Strong"
        android:layout_width="@dimen/l"
        android:layout_height="@dimen/l"
        android:gravity="center"
        android:background="@drawable/fair_qty_circle"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
