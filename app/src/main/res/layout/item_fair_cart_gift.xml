<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp">

    <ImageView android:id="@+id/image" android:layout_width="56dp" android:layout_height="64dp" android:scaleType="fitCenter"
        android:importantForAccessibility="no" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

    <id.co.edtslib.uikit.recipes.textbadge.klik.KlikTextBadge android:id="@+id/badge"
        android:layout_width="wrap_content" android:layout_height="24dp" android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/image" app:layout_constraintTop_toTopOf="parent" />

    <TextView android:id="@+id/name" style="@style/FairDemo.Strong" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:layout_marginStart="12dp" android:maxLines="2" android:ellipsize="end"
        app:layout_constraintStart_toEndOf="@id/image" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/badge" />

    <TextView android:id="@+id/pack" style="@style/FairDemo.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/black_40"
        app:layout_constraintStart_toStartOf="@id/name" app:layout_constraintTop_toBottomOf="@id/name" />

    <TextView android:id="@+id/discount" style="@style/FairSearch.SmallStrong" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textColor="@color/klik_color_red_30" android:background="@drawable/fair_discount_background"
        android:paddingHorizontal="6dp" android:paddingVertical="2dp"
        app:layout_constraintStart_toStartOf="@id/name" app:layout_constraintTop_toBottomOf="@id/pack" />

    <TextView android:id="@+id/originalPrice" style="@style/FairDemo.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:textColor="@color/black_40"
        app:layout_constraintStart_toEndOf="@id/discount" app:layout_constraintBaseline_toBaselineOf="@id/discount" />

    <TextView android:id="@+id/price" style="@style/FairDemo.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:textColor="@color/klik_color_red_30"
        app:layout_constraintStart_toEndOf="@id/originalPrice" app:layout_constraintBaseline_toBaselineOf="@id/discount" />

    <TextView android:id="@+id/qty" style="@style/FairDemo.Strong" android:layout_width="32dp" android:layout_height="32dp"
        android:gravity="center" android:background="@drawable/fair_qty_circle" android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>