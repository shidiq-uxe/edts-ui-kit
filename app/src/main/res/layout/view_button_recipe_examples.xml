<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <id.co.edtslib.uikit.recipes.button.klik.KlikButton
        android:id="@+id/klikButton"
        style="@style/Widget.EDTS.UIKit.Button.Klik.Secondary.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_recipe_action"
        android:textSize="18sp"
        android:textColor="@android:color/holo_green_dark"
        app:startIcon="@drawable/ic_placeholder_medium_24"
        app:endIcon="@drawable/ic_placeholder_medium_24"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <id.co.edtslib.uikit.recipes.button.poinku.PoinkuButton
        android:id="@+id/poinkuButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_recipe_action"
        app:buttonRecipe="@style/Widget.EDTS.UIKit.Button.Poinku.Text.Small"
        app:layout_constraintTop_toBottomOf="@id/klikButton"
        app:layout_constraintStart_toStartOf="parent" />

    <id.co.edtslib.uikit.core.button.CoreButton
        android:id="@+id/coreButton"
        style="@style/Widget.EDTS.UIKit.Button.Poinku.Outline.Large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_recipe_action"
        app:layout_constraintTop_toBottomOf="@id/poinkuButton"
        app:layout_constraintStart_toStartOf="parent" />

    <id.co.edtslib.uikit.button.Button
        android:id="@+id/legacyButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_recipe_action"
        app:buttonType="tertiaryLarge"
        app:isDestructive="true"
        app:pressedScale="0.8"
        app:layout_constraintTop_toBottomOf="@id/coreButton"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
