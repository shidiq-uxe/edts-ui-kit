<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/fair_skeleton_card"
    android:clipToOutline="true">
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/fair_skeleton_product_height"
        android:background="@color/black_20" />

    <View
        android:layout_width="@dimen/dimen_64"
        android:layout_height="@dimen/s"
        android:background="@drawable/fair_skeleton_block" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/xxs"
        android:orientation="vertical">
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/s"
            android:background="@drawable/fair_skeleton_block" />

        <View
            android:layout_width="@dimen/dimen_90"
            android:layout_height="@dimen/s"
            android:layout_marginTop="@dimen/xxxs"
            android:background="@drawable/fair_skeleton_block" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/m2"
            android:layout_marginTop="@dimen/xxxs"
            android:orientation="horizontal">
            <View
                android:layout_width="@dimen/m2"
                android:layout_height="match_parent"
                android:background="@drawable/fair_skeleton_block" />

            <View
                android:layout_width="@dimen/dimen_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/xxs"
                android:background="@drawable/fair_skeleton_block" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/dimen_90"
            android:layout_height="@dimen/m1"
            android:layout_marginTop="@dimen/xxxs"
            android:background="@drawable/fair_skeleton_block" />

        <View
            android:layout_width="@dimen/dimen_90"
            android:layout_height="@dimen/m1"
            android:layout_marginTop="@dimen/xxxs"
            android:background="@drawable/fair_skeleton_block" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/m2"
        android:layout_marginBottom="@dimen/xxxs"
        android:paddingHorizontal="@dimen/xxs"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <View
            android:layout_width="@dimen/dimen_0"
            android:layout_height="@dimen/xs"
            android:layout_weight="1"
            android:background="@drawable/fair_skeleton_block" />

        <View
            android:layout_width="@dimen/dimen_0"
            android:layout_height="@dimen/xs"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/xxs"
            android:background="@drawable/fair_skeleton_block" />
    </LinearLayout>
</LinearLayout>
