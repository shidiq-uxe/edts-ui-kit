<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GuidelinesChipActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="@dimen/dimen_16"
        android:paddingBottom="@dimen/dimen_32">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16"
            android:text="Chip"
            android:textAllCaps="true"
            style="@style/TextAppearance.Inter.Bold.B2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16"
            android:text="Live Preview"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="@dimen/dimen_8dp"
            app:cardBackgroundColor="@color/black_10"
            app:strokeWidth="1dp"
            app:strokeColor="@color/black_20"
            app:cardCornerRadius="@dimen/xxs"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:padding="@dimen/dimen_16"
                android:foregroundGravity="center">

                <id.co.edtslib.uikit.core.chip.CoreChip
                    android:id="@+id/previewChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center" />
            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_32"
            android:text="Core / Default Chip"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.core.chip.CoreChip
            android:id="@+id/chipCoreDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            app:chipVariant="@style/Widget.EDTS.UIKit.Chip.Core"
            app:isStartIconVisible="true"
            app:isEndIconVisible="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24"
            android:text="Klik — Suggestion"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.recipes.chip.klik.KlikChip
            android:id="@+id/chipKlikDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            app:chipVariant="@style/Widget.EDTS.UIKit.Chip.Klik.Suggestion"
            app:isStartIconVisible="true"
            app:isEndIconVisible="true" />

        <id.co.edtslib.uikit.recipes.chip.klik.KlikChip
            android:id="@+id/chipKlikChecked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            app:chipVariant="@style/Widget.EDTS.UIKit.Chip.Klik.Suggestion"
            app:chipState="active"
            app:isStartIconVisible="true"
            app:isEndIconVisible="true" />

        <id.co.edtslib.uikit.recipes.chip.klik.KlikChip
            android:id="@+id/chipKlikInactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            app:chipVariant="@style/Widget.EDTS.UIKit.Chip.Klik.Suggestion"
            app:chipState="selected"
            app:isStartIconVisible="true"
            app:isEndIconVisible="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24"
            android:text="Klik — Filters"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.recipes.chip.klik.KlikChip
            android:id="@+id/chipKlikFiltersDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            app:chipVariant="@style/Widget.EDTS.UIKit.Chip.Klik.Filters"
            app:isStartIconVisible="true"
            app:isEndIconVisible="true" />

        <id.co.edtslib.uikit.recipes.chip.klik.KlikChip
            android:id="@+id/chipKlikFiltersChecked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            app:chipVariant="@style/Widget.EDTS.UIKit.Chip.Klik.Filters"
            app:chipState="active"
            app:isStartIconVisible="true"
            app:isEndIconVisible="true" />

        <id.co.edtslib.uikit.recipes.chip.klik.KlikChip
            android:id="@+id/chipKlikFiltersInactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            app:chipVariant="@style/Widget.EDTS.UIKit.Chip.Klik.Filters"
            app:chipState="selected"
            app:isStartIconVisible="true"
            app:isEndIconVisible="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24"
            android:text="Poinku — Default"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.recipes.chip.poinku.PoinkuChip
            android:id="@+id/chipPoinkuDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            app:chipVariant="@style/Widget.EDTS.UIKit.Chip.Poinku"
            app:isStartIconVisible="true"
            app:isEndIconVisible="true" />

        <id.co.edtslib.uikit.recipes.chip.poinku.PoinkuChip
            android:id="@+id/chipPoinkuChecked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            app:chipVariant="@style/Widget.EDTS.UIKit.Chip.Poinku"
            app:chipState="active"
            app:isStartIconVisible="true"
            app:isEndIconVisible="true" />

        <id.co.edtslib.uikit.recipes.chip.poinku.PoinkuChip
            android:id="@+id/chipPoinkuInactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            app:chipVariant="@style/Widget.EDTS.UIKit.Chip.Poinku"
            app:chipState="selected"
            app:isStartIconVisible="true"
            app:isEndIconVisible="true" />

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/dimen_32dp"
            android:background="@color/black_10" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_32"
            android:text="Chip Group"
            android:textAllCaps="true"
            style="@style/TextAppearance.Inter.Bold.B2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16"
            android:text="Live Preview"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            app:cardBackgroundColor="@color/black_10"
            app:strokeWidth="1dp"
            app:strokeColor="@color/black_20"
            app:cardCornerRadius="@dimen/xxs"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:padding="@dimen/dimen_16">

                <id.co.edtslib.uikit.core.chipgroup.ChipGroup
                    android:id="@+id/chipGroupPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never" />
            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_32"
            android:text="Core"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.core.chipgroup.ChipGroup
            android:id="@+id/chipGroupCore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:orientation="horizontal"
            app:itemSpacingHorizontal="8dp"
            app:itemSpacingVertical="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24"
            android:text="Klik — Suggestion"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.core.chipgroup.ChipGroup
            android:id="@+id/chipGroupKlikSuggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:orientation="horizontal"
            app:itemSpacingHorizontal="8dp"
            app:itemSpacingVertical="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24"
            android:text="Klik — Filters"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.core.chipgroup.ChipGroup
            android:id="@+id/chipGroupKlikFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:orientation="horizontal"
            app:itemSpacingHorizontal="8dp"
            app:itemSpacingVertical="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_24"
            android:text="Poinku"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.core.chipgroup.ChipGroup
            android:id="@+id/chipGroupPoinku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            app:orientation="horizontal"
            app:itemSpacingHorizontal="8dp"
            app:itemSpacingVertical="8dp" />

    </LinearLayout>
</ScrollView>