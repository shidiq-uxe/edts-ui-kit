<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/xs"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/m2"
        android:layout_height="@dimen/m2"
        android:layout_marginStart="@dimen/s"
        android:src="@drawable/fair_search"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/query"
        style="@style/FairDemo.Caption"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/xxs"
        android:layout_marginEnd="@dimen/s"
        android:textColor="@color/black_60"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/icon"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/scope"
        style="@style/FairSearch.Scope"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/xxxs"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@id/query"
        app:layout_constraintStart_toStartOf="@id/query"
        app:layout_constraintEnd_toEndOf="@id/query"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
