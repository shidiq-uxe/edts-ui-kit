<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp"
    android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
    <ImageView android:id="@+id/icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="16dp"
        android:src="@drawable/fair_search" android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    <TextView android:id="@+id/query" style="@style/FairDemo.Caption" android:layout_width="0dp" android:layout_height="wrap_content"
        android:textColor="@color/black_60" android:layout_marginStart="8dp" android:layout_marginEnd="16dp" android:importantForAccessibility="no"
        app:layout_constraintStart_toEndOf="@id/icon" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/scope" style="@style/FairSearch.Scope" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="@id/query" app:layout_constraintEnd_toEndOf="@id/query"
        app:layout_constraintTop_toBottomOf="@id/query" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
