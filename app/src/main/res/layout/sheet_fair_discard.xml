<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <TextView android:id="@+id/message" style="@style/TextAppearance.Inter.Regular.P1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="16dp" android:text="Tetap di halaman dan simpan pilihanmu terlebih dahulu" />

    <View android:layout_width="match_parent" android:layout_height="4dp"
        android:background="@drawable/fair_shadow_top" android:importantForAccessibility="no" />

    <com.google.android.material.button.MaterialButton android:id="@+id/stay"
        style="@style/Widget.EDTS.UIKit.Button.Filled.Primary.Large"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="16dp" android:text="Tetap Di Halaman" />

    <com.google.android.material.button.MaterialButton android:id="@+id/discard"
        style="@style/Widget.EDTS.UIKit.Button.Outlined.Secondary.Large"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:text="Lanjut Tanpa Simpan" />
</LinearLayout>