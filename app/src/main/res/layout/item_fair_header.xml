<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:clipToOutline="false"
    android:clipChildren="false">
    <ImageView
        android:id="@+id/banner"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_0"
        android:src="@drawable/fair_banner"
        android:scaleType="centerCrop"
        android:contentDescription="@string/fair_name"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="360:128" />

    <TextView
        android:id="@+id/newUser"
        style="@style/FairDemo.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/s"
        android:layout_marginBottom="@dimen/xxxs"
        android:paddingHorizontal="@dimen/xxxs"
        android:paddingVertical="@dimen/dimen_3"
        android:text="@string/fair_new_customer_label"
        android:background="@drawable/fair_tag_disabled"
        android:textColor="@color/white"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/banner" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/progressPanel"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/s"
        android:layout_marginHorizontal="@dimen/s"
        android:padding="@dimen/xs"
        android:background="@drawable/fair_panel_background"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clipToOutline="false"
        android:elevation="@dimen/dimen_1"
        app:layout_constraintTop_toBottomOf="@id/banner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <id.co.edtslib.uikit.core.textbadge.CoreTextBadge
            android:id="@+id/fairBadge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/m2"
            app:layout_constrainedWidth="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/quotaBadge"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_bias="0" />

        <id.co.edtslib.uikit.recipes.textbadge.klik.KlikTextBadge
            android:id="@+id/quotaBadge"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/m2"
            android:layout_marginStart="@dimen/xxxs"
            android:layout_marginEnd="@dimen/xxs"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/fairBadge"
            app:layout_constraintEnd_toStartOf="@id/info" />

        <ImageButton
            android:id="@+id/info"
            android:layout_width="@dimen/s"
            android:layout_height="@dimen/s"
            android:padding="@dimen/dimen_0"
            android:scaleType="fitCenter"
            android:background="@null"
            android:clickable="false"
            android:focusable="false"
            android:src="@drawable/fair_info"
            android:contentDescription="@string/fair_info_description"
            app:layout_constraintTop_toTopOf="@id/fairBadge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/fairBadge" />

        <include
            android:id="@+id/meter"
            layout="@layout/view_fair_progress"
            android:layout_width="@dimen/dimen_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xxs"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clipToOutline="false"
            app:layout_constraintTop_toBottomOf="@id/fairBadge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gifts"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/fair_gift_image_size"
        android:layout_marginTop="@dimen/fair_gift_preview_overlap"
        android:layout_marginHorizontal="@dimen/s"
        android:paddingStart="@dimen/xs"
        android:paddingEnd="@dimen/xs"
        android:paddingTop="@dimen/m1"
        android:paddingBottom="@dimen/xxs"
        android:background="@drawable/fair_gift_background"
        android:contentDescription="@string/fair_view_gifts"
        app:layout_constraintTop_toBottomOf="@id/progressPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/giftOne"
            android:layout_width="@dimen/l"
            android:layout_height="@dimen/l"
            android:src="@drawable/fair_emina_gel"
            android:background="@drawable/fair_gift_image_rounded"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/giftTwo"
            android:layout_width="@dimen/l"
            android:layout_height="@dimen/l"
            android:layout_marginStart="@dimen/xxxs"
            android:src="@drawable/fair_gift_cotton"
            android:background="@drawable/fair_gift_image_rounded"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/giftOne" />

        <ImageView
            android:id="@+id/giftThree"
            android:layout_width="@dimen/l"
            android:layout_height="@dimen/l"
            android:layout_marginStart="@dimen/xxxs"
            android:src="@drawable/fair_gift_cleanser"
            android:background="@drawable/fair_gift_image_rounded"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/giftTwo" />

        <LinearLayout
            android:id="@+id/giftsAction"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dimen_0"
            android:paddingStart="@dimen/xxs"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/fair_view_gifts"
            android:background="@drawable/fair_ripple_rounded"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <TextView
                style="@style/TextAppearance.Foundation.Button.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/xxxs"
                android:text="@string/fair_see"
                android:textColor="@color/primary_30"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/giftChevron"
                android:layout_width="@dimen/s"
                android:layout_height="@dimen/s"
                android:padding="@dimen/xxxs"
                android:scaleType="fitCenter"
                android:src="@drawable/fair_chevron"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/promoTitle"
        style="@style/TextAppearance.Inter.SemiBold.P1"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/s"
        android:layout_marginTop="@dimen/xs"
        android:text="@string/fair_search_gift_title"
        android:maxLines="2"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@id/gifts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/periodIcon"
        android:layout_width="@dimen/s"
        android:layout_height="@dimen/s"
        android:layout_marginStart="@dimen/s"
        android:layout_marginTop="@dimen/xs"
        android:padding="@dimen/dimen_1"
        android:src="@drawable/fair_clock"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@id/promoTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/periodLabel"
        style="@style/TextAppearance.Inter.Medium.B3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/xxxs"
        android:text="@string/fair_period_label"
        android:textColor="@color/black_40"
        app:layout_constraintTop_toTopOf="@id/periodIcon"
        app:layout_constraintStart_toEndOf="@id/periodIcon" />

    <TextView
        android:id="@+id/periodValue"
        style="@style/TextAppearance.Inter.SemiBold.B3"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/xxs"
        android:layout_marginEnd="@dimen/s"
        android:text="@string/fair_period_value"
        android:gravity="end"
        android:textColor="@color/black_60"
        app:layout_constraintTop_toTopOf="@id/periodIcon"
        app:layout_constraintStart_toEndOf="@id/periodLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/periodBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="periodIcon,periodLabel,periodValue" />

    <ImageView
        android:id="@+id/minimumIcon"
        android:layout_width="@dimen/s"
        android:layout_height="@dimen/s"
        android:layout_marginStart="@dimen/s"
        android:layout_marginTop="@dimen/xxs"
        android:padding="@dimen/dimen_1"
        android:src="@drawable/fair_minimum"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@id/periodBottom"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/minimumLabel"
        style="@style/TextAppearance.Inter.Medium.B3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/xxxs"
        android:text="@string/fair_minimum_label"
        android:textColor="@color/black_40"
        app:layout_constraintTop_toTopOf="@id/minimumIcon"
        app:layout_constraintStart_toEndOf="@id/minimumIcon" />

    <TextView
        android:id="@+id/minimumValue"
        style="@style/TextAppearance.Inter.SemiBold.B3"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/xxs"
        android:layout_marginEnd="@dimen/s"
        android:textColor="@color/black_60"
        android:text="@string/fair_initial_price"
        android:gravity="end"
        app:layout_constraintTop_toTopOf="@id/minimumIcon"
        app:layout_constraintStart_toEndOf="@id/minimumLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/minimumBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="minimumIcon,minimumLabel,minimumValue" />

    <ImageView
        android:id="@+id/termsIcon"
        android:layout_width="@dimen/s"
        android:layout_height="@dimen/s"
        android:layout_marginStart="@dimen/s"
        android:layout_marginTop="@dimen/xxs"
        android:padding="@dimen/dimen_1"
        android:src="@drawable/fair_terms"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toBottomOf="@id/minimumBottom"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/termsLabel"
        style="@style/TextAppearance.Inter.Medium.B3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/xxxs"
        android:text="@string/fair_terms_label"
        android:textColor="@color/black_40"
        app:layout_constraintTop_toTopOf="@id/termsIcon"
        app:layout_constraintStart_toEndOf="@id/termsIcon" />

    <TextView
        android:id="@+id/terms"
        style="@style/TextAppearance.Foundation.Button.Small"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/xxs"
        android:layout_marginEnd="@dimen/s"
        android:text="@string/fair_terms"
        android:textColor="@color/primary_30"
        android:gravity="end"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/fair_read_terms_description"
        app:layout_constraintTop_toTopOf="@id/termsIcon"
        app:layout_constraintStart_toEndOf="@id/termsLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/termsBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="termsIcon,termsLabel,terms" />

    <View
        android:id="@+id/headerDivider"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/dimen_1"
        android:layout_marginTop="@dimen/s"
        android:background="@color/black_30"
        app:layout_constraintTop_toBottomOf="@id/termsBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
