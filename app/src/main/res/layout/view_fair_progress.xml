<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToOutline="false"
    android:clipToPadding="false">
    <id.co.edtslib.uikit.progressbar.LinearProgressBar
        android:id="@+id/progressBar"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="@dimen/xxs"
        android:importantForAccessibility="no"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:clipToOutline="false"
        app:maxIndicatorProgress="100"
        app:progressLimit="100"
        app:showBadge="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/message"
        style="@style/TextAppearance.Inter.Medium.B3"
        android:layout_width="@dimen/dimen_0"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/s"
        android:layout_marginTop="@dimen/xxs"
        android:layout_marginEnd="@dimen/xxs"
        android:textColor="@color/black_50"
        android:gravity="center_vertical"
        android:text="@string/fair_message_start"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/seeGifts"
        app:layout_goneMarginEnd="@dimen/dimen_0"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/seeGifts"
        style="@style/FairDemo.CaptionStrong"
        android:layout_width="@dimen/fair_action_width"
        android:layout_height="@dimen/l"
        android:layout_marginTop="@dimen/xxs"
        android:background="@drawable/fair_button_blue"
        android:textColor="@color/white"
        android:gravity="center"
        android:text="@string/fair_see"
        android:contentDescription="@string/fair_view_gifts"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progressBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
