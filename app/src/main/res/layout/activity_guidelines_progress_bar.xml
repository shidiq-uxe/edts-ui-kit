<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GuidelinesProgressBarActivity">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipChildren="false"
        android:paddingHorizontal="@dimen/dimen_16"
        android:paddingBottom="@dimen/dimen_32">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_16"
            android:text="Live Preview"
            android:layout_gravity="center"
            style="@style/TextAppearance.Inter.SemiBold.B2" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:minHeight="80dp"
            app:cardBackgroundColor="@color/black_10"
            app:strokeWidth="1dp"
            app:strokeColor="@color/black_20"
            app:cardCornerRadius="@dimen/xxs"
            app:cardElevation="0dp">

            <FrameLayout
                android:id="@+id/previewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:padding="@dimen/dimen_16" />

        </com.google.android.material.card.MaterialCardView>
        <id.co.edtslib.uikit.button.Button
            android:id="@+id/btnPreviewAnimate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:text="Animate Progress" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_32"
            android:text="Linear Progress Bar"
            android:gravity="center"
            android:layout_gravity="center"
            android:background="@color/info_background"
            android:padding="@dimen/xxs"
            style="@style/TextAppearance.Inter.Semibold.H2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_32"
            android:text="Single Lap"
            android:layout_gravity="center"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.core.linearprogressbar.CoreLinearProgressBar
            android:id="@+id/gLPBSingleLap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp" />

        <id.co.edtslib.uikit.button.Button
            android:id="@+id/btnProgressSingleLap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:text="Animate Progress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_32"
            android:text="Multi Lap"
            android:layout_gravity="center"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.core.linearprogressbar.CoreLinearProgressBar
            android:id="@+id/gLPBMultiLap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp" />

        <id.co.edtslib.uikit.button.Button
            android:id="@+id/btnProgressMultiLap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:text="Animate Progress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_32"
            android:text="Loading State"
            android:layout_gravity="center"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.core.linearprogressbar.CoreLinearProgressBar
            android:id="@+id/gLPBLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp" />

        <id.co.edtslib.uikit.button.Button
            android:id="@+id/btnProgressLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:text="Animate Progress" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_32"
            android:text="Disabled State"
            android:layout_gravity="center"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.core.linearprogressbar.CoreLinearProgressBar
            android:id="@+id/gLPBDisabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_32"
            android:text="Intermittent State"
            android:layout_gravity="center"
            style="@style/TextAppearance.Inter.SemiBold.B3" />

        <id.co.edtslib.uikit.core.linearprogressbar.CoreLinearProgressBar
            android:id="@+id/gLPBIntermittentFixed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp" />

        <id.co.edtslib.uikit.core.linearprogressbar.CoreLinearProgressBar
            android:id="@+id/gLPBIntermittentStretch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_32"
            android:text="Circular Progress Bar"
            android:gravity="center"
            android:layout_gravity="center"
            android:background="@color/info_background"
            android:padding="@dimen/xxs"
            style="@style/TextAppearance.Inter.Semibold.H2" />

        <id.co.edtslib.uikit.progressindicator.DoubleArcProgressIndicator
            android:id="@+id/piSample"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp" />

        <id.co.edtslib.uikit.progressbar.GradientCircularProgressBar
            android:id="@+id/gCPB"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:layout_gravity="center"
            app:indicatorProgress="20" />
        <id.co.edtslib.uikit.button.Button
            android:id="@+id/btnVisibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:text="Animate Progress" />

    </LinearLayout>
</ScrollView>