<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView android:id="@+id/scroll"
        android:layout_width="0dp" android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="16dp">
            <LinearLayout android:id="@+id/lockedSection" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <TextView android:id="@+id/heading" style="@style/FairDemo.Strong" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:text="Pilih Tebus Murah"
                    app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/counter"
                    app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
                <TextView android:id="@+id/counter" style="@style/FairDemo.CaptionBold" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:background="@drawable/fair_counter_background"
                    android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:textColor="@color/primary_30" android:text="0/2"
                    app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp" android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View android:id="@+id/footerShadow" android:layout_width="0dp" android:layout_height="4dp"
        android:background="@drawable/fair_shadow_top" android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <FrameLayout android:id="@+id/footer" android:layout_width="0dp" android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="16dp" android:paddingTop="16dp" android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/scroll" app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.button.MaterialButton android:id="@+id/update"
            style="@style/Widget.EDTS.UIKit.Button.Filled.Primary.Large"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Perbarui Keranjang" android:enabled="false" app:iconGravity="textStart" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>