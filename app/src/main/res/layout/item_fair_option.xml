<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="12dp">
    <ImageView android:id="@+id/image" android:layout_width="56dp" android:layout_height="56dp" android:visibility="gone" android:importantForAccessibility="no"
        android:scaleType="fitCenter" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    <TextView android:id="@+id/label" style="@style/FairDemo.Body" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" app:layout_goneMarginStart="0dp" android:layout_marginEnd="8dp"
        app:layout_constraintStart_toEndOf="@id/image" app:layout_constraintEnd_toStartOf="@id/check"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
    <ImageView android:id="@+id/check" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_check"
        android:importantForAccessibility="no" android:visibility="invisible" app:tint="@color/primary_30"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
