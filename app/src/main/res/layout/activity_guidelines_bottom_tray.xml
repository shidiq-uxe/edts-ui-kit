<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/s"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/motion_stepper_title"
            android:textAppearance="@style/TextAppearance.Inter.Semibold.H1" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xxs"
            android:text="@string/motion_stepper_hint"
            android:textAppearance="@style/TextAppearance.Inter.Regular.B2" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s"
            android:text="@string/motion_stepper_animated"
            android:textAppearance="@style/TextAppearance.Inter.SemiBold.B2" />

        <id.co.edtslib.uikit.stepper.StepperButton
            android:id="@+id/stepperAnimated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xxs" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s"
            android:text="@string/motion_stepper_instant"
            android:textAppearance="@style/TextAppearance.Inter.SemiBold.B2" />

        <id.co.edtslib.uikit.stepper.StepperButton
            android:id="@+id/stepperInstant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xxs" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s"
            android:text="@string/motion_stepper_editable"
            android:textAppearance="@style/TextAppearance.Inter.SemiBold.B2" />

        <id.co.edtslib.uikit.stepper.StepperButton
            android:id="@+id/stepperEditable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xxs" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s"
            android:text="@string/motion_stepper_disabled"
            android:textAppearance="@style/TextAppearance.Inter.SemiBold.B2" />

        <id.co.edtslib.uikit.stepper.StepperButton
            android:id="@+id/stepperDisabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xxs" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s"
            android:text="@string/motion_stepper_collapsed"
            android:textAppearance="@style/TextAppearance.Inter.SemiBold.B2" />

        <id.co.edtslib.uikit.stepper.StepperButton
            android:id="@+id/stepperCollapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xxs" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/l"
            android:text="@string/motion_tray_title"
            android:textAppearance="@style/TextAppearance.Inter.Semibold.H1" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvBSBehavior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xxs"
            android:text="@string/motion_tray_hint"
            android:textAppearance="@style/TextAppearance.Inter.Regular.B2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowBottomSheet"
            style="@style/Widget.EDTS.UIKit.Button.Filled.Primary.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/s"
            android:text="@string/motion_tray_custom" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowMaterialSheet"
            style="@style/Widget.EDTS.UIKit.Button.Outlined.Secondary.Medium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/xxs"
            android:text="@string/motion_tray_material" />

    </LinearLayout>
</ScrollView>
